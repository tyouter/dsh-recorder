{
  "name": "@tyouter/dsh-recorder",
  "version": "0.1.0",
  "type": "module",
  "description": "Drive another DSH plugin's real interface like a person and record the real window to GIF or stills.",
  "license": "MIT",
  "author": "tyouter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyouter/dsh-recorder.git"
  },
  "homepage": "https://github.com/tyouter/dsh-recorder#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "recorder",
    "gif",
    "demo"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/record-window.py",
    "examples/*.json",
    "README.md",
    "HANDOFF.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
